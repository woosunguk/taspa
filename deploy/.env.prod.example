# deploy/docker-compose.prod.yml 용 환경변수 예시.
# 복사해서 `deploy/.env.prod` 로 두고 값을 채운다 — **그 파일은 커밋하지 않는다**(.gitignore).
# 시크릿 매니저를 쓴다면 이 파일 대신 오케스트레이터가 같은 이름으로 주입하면 된다.

# ── 이미지 (고정 태그 — :latest 금지) ───────────────────────────────────────────
TASPA_SERVER_IMAGE=ghcr.io/example/taspa-server:0.0.1
TASPA_WEB_IMAGE=ghcr.io/example/taspa-web:0.0.1

# ── DB (외부 관리형 Postgres 16) ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://db.internal:5432/taspa
DB_USERNAME=taspa_app
DB_PASSWORD=
# DB_POOL_SIZE=20        # Postgres max_connections ÷ 인스턴스 수 이하로

# ── 메일 (인증 코드·초대·로그인 알림) ────────────────────────────────────────────
MAIL_HOST=smtp.example.com
# MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 리버스 프록시 신뢰 대역 (정규식) ─────────────────────────────────────────────
# 예: 도커 브리지 172.16~31 대역 → 172\.(1[6-9]|2[0-9]|3[01])\..*
TASPA_TRUSTED_PROXIES=

# ── 공개 주소 (https 필수, localhost 금지) ──────────────────────────────────────
TASPA_ISSUER_URI=https://id.example.com
# 메일 링크(비밀번호 재설정·매직링크·조직 초대)의 base. **줄 자체를 지운 채로 두면** issuer 를 쓴다.
# ★값 없이 `TASPA_PUBLIC_BASE_URL=` 로 남겨도 무방하다(매니페스트가 맨 키 형태라 빈 값은 전달되지 않는다).
# SPA 를 별도 도메인에 둔다면 그 도메인을 지정할 것.
# TASPA_PUBLIC_BASE_URL=https://app.example.com
TASPA_WEBAUTHN_RP_ID=id.example.com
TASPA_WEBAUTHN_ALLOWED_ORIGINS=https://id.example.com

# ── 암호화 키 (각각 따로 뽑는다 — 같은 값이면 기동 거부) ─────────────────────────
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY=
TASPA_JWK_ENCRYPTION_KEY=

# ── 선택 ────────────────────────────────────────────────────────────────────────
# TASPA_METRICS_SCRAPE_PASSWORD=   # 설정해야 /actuator/prometheus 스크레이핑이 가능하다
# TASPA_ADMIN_EMAILS=              # 기동 시 이 계정들을 ADMIN 으로 승격(계정이 이미 있어야 한다)

# ── POS 단말(가맹 계산대) — 쓰지 않으면 비워 둔다 ────────────────────────────────
# POS_TERMINAL_KEY=                # 단말 등록 키. 약하면 등록 기능 자체가 꺼진다(fail-closed)
# POS_SESSION_SECRET=              # 단말 쿠키 서명 키. 위 키와 HMAC 해 "키 교체=전 단말 즉시 무효"
# POS_TRUSTED_PROXY=               # 선언했을 때만 X-Forwarded-For 를 스로틀 버킷 키로 쓴다
# POS_CLIENT_ID=                   # 가맹 결속 M2M 클라이언트(/admin/clients 에서 발급)
# POS_CLIENT_SECRET=
