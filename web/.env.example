# taspa web — 환경변수 예시
#
# 실제 값을 이 파일에 넣지 마세요. 복사해서 `.env.local` 로 만들고 거기에 채웁니다(.gitignore 대상).
#   cp .env.example .env.local

# ---------------------------------------------------------------- 공통

# taspa 인증 서버 오리진. 미설정 시 http://localhost:9100.
# next.config.ts 의 동일 오리진 프록시와 POS 단말 BFF 가 **같은 값**을 씁니다.
#
# ★컨테이너 배포에서는 이 값이 **빌드 시각에 굳습니다**. next.config.ts 의 rewrites() 는 빌드 중
#   한 번만 평가돼 목적지가 산출물에 직렬화되므로, 런타임 env 로만 덮으면 프록시는 옛 오리진을
#   계속 봅니다(POS 결제 중계는 런타임 값을 읽어 서로 갈라집니다). 그래서 오리진을 바꾸려면
#   `--build-arg TASPA_ORIGIN=...` 로 **다시 빌드**해야 합니다. 분기 상태로 뜨면 POS BFF 가
#   첫 요청에서 명시적으로 실패합니다(lib/pos-terminal.ts 가드) — 조용히 어긋나지 않습니다.
#   dev 서버(`npx next dev`)는 매 기동에 rewrites 를 다시 평가하므로 이 제약이 없습니다.
TASPA_ORIGIN=http://localhost:9100


# --------------------------------------------------- POS 단말 (/pos) 자격증명
#
# 매장 계산대 화면(/pos)이 결제를 승인하려면 taspa 의 M2M 액세스 토큰이 필요합니다.
# 이 자격증명은 **Next 서버 프로세스에만** 존재하며 브라우저로 전달되지 않습니다
# (secret 을 브라우저에 두면 단말 한 대만 열려도 그 매장의 승인·취소 권한이 통째로 유출됩니다).
# 값이 없으면 /pos 는 "단말이 등록되지 않았습니다"를 표시하고 기능을 잠급니다.
#
# 발급 방법(플랫폼 관리자):
#   1) /admin/merchants 에서 가맹을 등록하고 merchantId 를 확인합니다.
#   2) /admin/clients 에서 **기밀(confidential)** 클라이언트를 만들고
#      - grant type: client_credentials
#      - scope: meal.redeem
#      - merchantId: 위 가맹 UUID (토큰의 merchant_id 클레임 = 이 단말이 승인할 수 있는 유일한 매장)
#   3) 등록 응답에 1회만 표시되는 client secret 을 아래에 넣습니다.
#
# 단말 1대 = 매장 1곳입니다. 여러 매장을 한 서버로 운영하려면 매장별로 배포를 분리하세요.
POS_CLIENT_ID=
POS_CLIENT_SECRET=


# ------------------------------------------------------ POS 단말 등록 (필수)
#
# 위 자격증명만으로는 부족합니다. `/pos` 와 손님용 `/meal` 은 **같은 앱**이므로, 단말 인증이 없으면
# 손님이 `/meal` 에서 발급받은 자기 QR 을 `/api/pos/redeem` 에 직접 보내 매장에 가지도 않고 회사
# 예산으로 결제를 성립시킬 수 있습니다(응답의 authId 로 자기 결제를 취소하는 것도 가능). "매장
# 네트워크로만 접근 허용" 같은 완화책은 성립하지 않습니다 — 손님도 QR 을 받으려면 같은 앱에 닿아야
# 하기 때문입니다.
#
# 그래서 **브라우저가 단말임을 증명**하게 합니다. 매장 직원이 /pos 에서 등록 키를 한 번 입력하면
# 서명된 httpOnly 쿠키가 심기고, 그 쿠키가 있는 요청만 승인·취소가 중계됩니다.
# 값이 없거나 키가 약하면 /pos 는 잠긴 상태로 남습니다(fail-closed).
#
#   POS_TERMINAL_KEY   직원이 입력하는 등록 키. 매장 직원만 알아야 합니다. 반드시 이렇게 만드세요:
#                        openssl rand -base64 32
#                      등록 엔드포인트는 인증 없이 열려 있어야 하므로(그게 등록의 정의입니다) 이 값은
#                      추측 대상입니다. 서버는 길이·문자 다양성·추정 엔트로피(16자 이상, 8종 이상,
#                      80비트 이상)를 검사하고, 미달이면 **등록 기능을 꺼 버립니다** — /pos 가
#                      "단말이 등록되지 않았습니다"로 남고 결제도 열리지 않습니다.
#                      검사는 기동 시점이 아니라 **첫 요청 시** 이뤄집니다. 약한 키로도 배포 자체는
#                      성공하므로, 배포 후 /pos 를 한 번 열어 잠기지 않았는지 확인하세요
#                      (잠겼다면 화면이 사유를 알려 주고 서버 로그에도 남습니다).
#
#   POS_SESSION_SECRET 쿠키 서명의 기반 비밀. 미설정 시 POS_CLIENT_SECRET 에서 파생하므로 생략 가능하지만,
#                      분리해 두면 client secret 을 교체해도 단말이 로그아웃되지 않습니다.
#
# ▸ 단말 회수(분실·유출·퇴사)
#   쿠키 서명 키는 POS_SESSION_SECRET 으로 POS_TERMINAL_KEY 를 HMAC 한 값입니다. 따라서 **둘 중
#   아무 값이나 바꾸고 서버를 재기동하면 이미 나간 단말 쿠키가 전부 즉시 무효**가 되고, 모든 단말이
#   다시 등록해야 합니다. 이것이 유일한 즉시 회수 수단입니다(개별 단말만 끊는 기능은 없습니다).
#   그 외에는 쿠키가 스스로 만료합니다: 마지막 사용으로부터 7일(유휴), 최초 등록으로부터 90일(절대).
#   영업 중인 단말은 /pos 를 열 때마다 유휴 기한이 갱신되므로 재등록 요구를 받지 않습니다.
#
# ▸ 등록 시도 제한
#   틀린 키를 반복하면 요청마다 지연이 붙고(최대 2초, 발신지와 무관하게 전역 직렬화) 곧 429 +
#   Retry-After 로 거절됩니다. **맞는 키는 이 제한과 무관하게 통과**합니다 — 그래야 외부인이 시도를
#   퍼부어 매장의 등록을 봉쇄하는 표적 공격이 성립하지 않습니다. 실제 방어선은 위의 키 엔트로피입니다.
POS_TERMINAL_KEY=
POS_SESSION_SECRET=


# ------------------------------------------------- POS 등록 시도 제한: 프록시 신뢰 (선택)
#
# 등록 시도를 **발신지별로** 세려면 클라이언트 IP 를 알아야 하는데, 그 값은 `X-Forwarded-For` 헤더로
# 오고 헤더는 누구나 위조할 수 있습니다. 그래서 이 앱은 **신뢰를 명시적으로 선언했을 때만** 헤더를
# 봅니다. 선언이 없으면(기본) 발신지 구분을 아예 포기하고 모든 시도를 한 카운터로 셉니다 —
# 헤더를 아무리 돌려도 우회가 성립하지 않습니다.
#
# 값 = 이 앱 앞에 있는 **신뢰하는 프록시의 개수**(1 이면 "true" 도 가능). 프록시는 자기가 본 주소를
# 헤더 뒤에 덧붙이므로, 서버는 오른쪽에서 그만큼 떨어진 값을 클라이언트 주소로 읽습니다.
#
# ⚠ 실제로 프록시 뒤에 있을 때만, 실제 홉 수와 정확히 일치시켜 설정하세요. 프록시가 없는데 켜면
#   클라이언트가 보낸 헤더를 그대로 믿게 되어 제한이 다시 무력해집니다.
POS_TRUSTED_PROXY=
